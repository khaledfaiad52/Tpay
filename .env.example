# TPay mobile — environment template.
# Copy to `.env.local` and fill in. Never commit real values.
#
# Only EXPO_PUBLIC_* variables reach the app bundle, and everything that
# reaches the bundle is readable by anyone with the app. Provider API keys,
# webhook secrets and database credentials belong on the TPay backend, never
# here. Nothing in this file is a secret.

# ---------------------------------------------------------------------------
# Which deployment this build is: development | staging | production
#
# Unset or unrecognised means development. A build that means to be production
# has to say so — and in production every demo control below is refused
# outright, not merely defaulted off.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_TPAY_ENV=development

# Which service adapter set backs the app: `mock` today.
# Provider-backed sets are added in src/services/registry.ts as they land.
# The app never names a provider in its UI, and never holds a provider key.
EXPO_PUBLIC_TPAY_PROVIDER=mock

# Base URL of the TPay backend. Leave unset while running on mock data.
#   development  http://localhost:4000
#   staging      https://api.staging.tpay.example
#   production   https://api.tpay.example
EXPO_PUBLIC_TPAY_API_BASE_URL=

# Mock-layer tuning, for demoing loading and error states.
# Simulated round-trip in milliseconds (default 420).
EXPO_PUBLIC_TPAY_MOCK_LATENCY_MS=
# Fraction of mock calls that fail, 0–1 (default 0). Set to 1 to see every
# screen's error state.
EXPO_PUBLIC_TPAY_MOCK_FAILURE_RATE=

# ---------------------------------------------------------------------------
# Development and test affordances. Absent, empty or anything other than
# `true` keeps them off, and `EXPO_PUBLIC_TPAY_ENV=production` disables them
# whatever they say.
# ---------------------------------------------------------------------------
# Applies a reviewer's verification outcome from the identity screen, through
# the same callback seam a real provider webhook lands on.
EXPO_PUBLIC_ENABLE_KYC_DEMO=
# Authorises a card purchase from the card screen, through the same seam a
# real card processor would use.
EXPO_PUBLIC_ENABLE_CARD_DEMO=
# Expires the session from the Security screen, so session recovery can be
# exercised without waiting out a token.
EXPO_PUBLIC_ENABLE_SESSION_DEMO=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — configure these on the TPay backend, NOT in this file and
# NOT in any EXPO_PUBLIC_ variable. Listed so it is obvious where they live.
#
# A mobile bundle is readable by anyone who installs the app. None of these
# may ever be compiled into it, and none of the calls that need them may ever
# be made from the device.
#
# Identity / auth
#   AUTH_PROVIDER_CLIENT_ID / AUTH_PROVIDER_CLIENT_SECRET
#   TPAY_JWT_SIGNING_KEY
#   TPAY_REFRESH_TOKEN_SECRET
#   SMS_PROVIDER_API_KEY             (one-time codes)
#
# Money movement — the app never calls these directly
#   AIRWALLEX_CLIENT_ID / AIRWALLEX_API_KEY
#   THUNES_API_KEY / THUNES_API_SECRET
#   TERRAPAY_API_KEY / TERRAPAY_API_SECRET
#   NIUM_API_KEY
#
# Verification and cards
#   KYC_PROVIDER_API_KEY
#   CARD_PROVIDER_API_KEY / CARD_PROVIDER_PAN_TOKEN_KEY
#   SUPPORT_PROVIDER_API_KEY
#
# Webhook signature verification — the receiver is a server, never the app
#   KYC_WEBHOOK_SECRET
#   TRANSFER_WEBHOOK_SECRET
#   CARD_WEBHOOK_SECRET
#
# Data
#   DATABASE_URL
# ---------------------------------------------------------------------------
